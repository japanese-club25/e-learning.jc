generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Question {
  id              String         @id @default(uuid())
  question_text   String
  option_a        String
  option_b        String
  option_c        String
  option_d        String
  correct_option  Option
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  explanation     String?
  image_url       String?
  image_public_id String?
  answers         Answer[]
  exam_questions  ExamQuestion[]

  @@map("questions")
}

model Exam {
  id             String         @id @default(uuid())
  category       Category
  duration       Int            @default(60)
  start_time     DateTime?
  end_time       DateTime?
  is_active      Boolean        @default(false)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  exam_code      String         @unique
  name           String         @default("")
  exam_questions ExamQuestion[]
  scores         Score[]
  attempts       ExamAttempt[]

  @@map("exams")
}

model ExamQuestion {
  id          String   @id @default(uuid())
  exam_id     String
  question_id String
  created_at  DateTime @default(now())
  exam        Exam     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, question_id])
  @@map("exam_questions")
}

model Student {
  id             String       @id @default(uuid())
  email          String?      @unique
  password_hash  String?
  is_first_login Boolean      @default(true)
  name           String
  class          String
  exam_code      String
  started_at     DateTime?    @default(now())
  violations     Int          @default(0)
  is_submitted   Boolean      @default(false)
  created_at     DateTime     @default(now())
  answers        Answer[]
  Attendance     Attendance[]
  scores         Score[]
  ExamAttempt    ExamAttempt[]
  AuthToken      AuthToken[]

  @@map("students")
}

model ExamAttempt {
  id          String        @id @default(uuid())
  exam_id     String
  student_id  String
  started_at  DateTime      @default(now())
  finished_at DateTime?
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int?

  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, student_id])
  @@map("exam_attempts")
}

model Answer {
  id          String   @id @default(uuid())
  student_id  String
  question_id String
  answer      Option?
  is_correct  Boolean?
  created_at  DateTime @default(now())
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, question_id])
  @@map("answers")
}

model Score {
  id              String   @id @default(uuid())
  student_id      String
  exam_id         String
  score           Int      @default(0)
  total_questions Int      @default(0)
  percentage      Decimal  @default(0.00) @db.Decimal(5, 2)
  is_published    Boolean  @default(false)
  created_at      DateTime @default(now())
  exam            Exam     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, exam_id])
  @@map("scores")
}

model Material {
  id           String    @id @default(uuid())
  title        String
  content      String
  category     Category
  description  String?
  author_id    String
  is_published Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  author       AdminUser @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@map("materials")
}

model AdminUser {
  id            String       @id @default(uuid())
  password_hash String
  created_at    DateTime     @default(now())
  email         String       @unique
  Attendance    Attendance[]
  Material      Material[]
  AuthToken     AuthToken[]

  @@map("admin_users")
}

model AuthToken {
  id           String    @id @default(uuid())
  token        String    @unique
  user_id      String?
  student_id   String?
  user         AdminUser? @relation(fields: [user_id], references: [id], onDelete: Cascade)
  student      Student?   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  expires_at   DateTime
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  user_agent   String?
  ip_address   String?
  is_revoked   Boolean   @default(false)

  @@index([token])
  @@index([user_id])
  @@index([student_id])
  @@index([expires_at])
  @@map("auth_tokens")
}

model Attendance {
  id               String           @id @default(uuid())
  student_id       String
  date             DateTime         @default(now())
  status           AttendanceStatus
  recorded_at      DateTime         @default(now())
  scanned_admin_id String
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  meeting_id       String
  device_id        String           @default("unknown")
  fingerprint_hash String?
  reason           String?
  latitude         Float?
  longitude        Float?
  distance         Float?
  meeting          Meeting          @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  scannedByAdmin   AdminUser        @relation(fields: [scanned_admin_id], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, meeting_id])
  @@index([device_id])
  @@index([recorded_at])
  @@map("attendances")
}

model Meeting {
  id                String            @id @default(uuid())
  title             String            @default("")
  starts_at         DateTime?
  ends_at           DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  is_active         Boolean           @default(true)
  // GPS geofencing (null latitude/longitude = geofence disabled for this meeting)
  latitude          Float?
  longitude         Float?
  radius            Int               @default(150) // meters
  // Google Sheets sync metadata (never source of truth)
  google_sheet_id   String? // Numeric sheetId within the spreadsheet
  google_sheet_name String? // Worksheet tab name e.g. "Meeting-abc123"
  last_synced_at    DateTime? // Timestamp of last successful sync
  sync_status       SyncStatus        @default(PENDING)
  sync_error        String? // Last error message if sync failed
  attendances       Attendance[]
  qr_tokens         MeetingQrToken[]

  @@map("meetings")
}

model MeetingQrToken {
  id         String    @id @default(uuid())
  meeting_id String
  token_hash String    @unique
  expires_at DateTime?
  is_revoked Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  @@index([meeting_id])
  @@index([expires_at])
  @@map("meeting_qr_tokens")
}

enum Category {
  Gengo
  Bunka
}

enum Option {
  A
  B
  C
  D
}

enum AttendanceStatus {
  HADIR
  TIDAK_HADIR
  TERLAMBAT
  IZIN
}

enum SyncStatus {
  PENDING // Never synced or reset
  SYNCING // In progress (prevents duplicate requests)
  SYNCED // Last sync was successful
  FAILED // Last sync failed, retry allowed
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}
